print (neg 9000000000000000000) + neg 9000000000000000000
print (neg 9000000000000000000) - 9000000000000000000
print (neg 5000000000) * 5000000000
print (neg 5000000000) + 1:3
print to :rational @[neg 5000000000 3]
print to :rational @[5000000000 neg 3]

; results that fit in a normal Integer shouldn't remain "big"
z: (2^70) - ((2^70) - 3)
print z
print integer?.big z
print shl 1 z
print size 1..z
print get [1 2 3 4] z
print repeat "a" z
print to :floating z
print integer?.big div 2^70 2^68
print integer?.big (neg 2^63)
print integer?.big 2^63
print integer?.big (9223372036854775807 + 1) - 1
