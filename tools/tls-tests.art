; temporary: extended TLS test suite (for the mbedTLS switch)
;
; prints one deterministic line per check ("[group] name: ok|error"),
; so that outputs of different builds (mbedTLS vs OpenSSL) can be diffed
; with TLS_VERBOSE set, error messages are appended after " | "
;
; read/request/*.async use no verification (CVerifyNone),
; download goes through httpclient's default context (CVerifyPeer)

verbose?: key? env "TLS_VERBOSE"
tmp: path\temp ++ "tls-tests.tmp"

report: function [group, name, err][
    s: ~"[|group|] |name|: "
    s: s ++ (null? err)? -> "ok" -> "error"
    if and? verbose? not? null? err [
        msg: strip replace err\message {/\s+/} " "
        s: s ++ " | " ++ msg
    ]
    print s
]

attempt: function [group, name, action][
    report group name try action
]

;------------------------------------------
; badssl.com: certificates, keys, protocols, ciphers
;------------------------------------------

badssl: [
    ; certificates
    "expired" "wrong.host" "self-signed" "untrusted-root" "revoked" "pinning-test"
    "no-common-name" "no-subject" "incomplete-chain" "no-sct" "invalid-expected-sct"
    "sha256" "sha384" "sha512" "1000-sans" "10000-sans" "extended-validation"
    "ecc256" "ecc384" "rsa2048" "rsa4096" "rsa8192"
    "long-extended-subdomain-name-containing-many-letters-and-dashes"
    "longextendedsubdomainnamewithoutdashesinordertotestwordwrapping"
    ; protocols & ciphers
    "tls-v1-0:1010" "tls-v1-1:1011" "tls-v1-2:1012"
    "mozilla-modern" "mozilla-intermediate" "mozilla-old"
    "cbc" "rc4-md5" "rc4" "3des" "null"
    "dh480" "dh512" "dh1024" "dh2048" "dh-small-subgroup" "dh-composite" "static-rsa"
    ; misc
    "hsts" "upgrade" "client-cert-missing"
]

loop badssl 'h [
    parts: split.by: ":" h
    host: ~"|first parts|.badssl.com"
    if 1 < size parts -> host: ~"|host|:|last parts|"
    url: ~"https://|host|/"
    attempt "badssl" ~"|h| noverify" [read url]
    attempt "badssl" ~"|h| verify" [download.as: tmp url]
]

;------------------------------------------
; real-world hosts (different CAs & CDNs)
;------------------------------------------

hosts: [
    "arturo-lang.io" "pkgr.art" "github.com" "api.github.com" "raw.githubusercontent.com"
    "www.google.com" "www.cloudflare.com" "en.wikipedia.org" "www.microsoft.com"
    "www.apple.com" "letsencrypt.org" "www.digicert.com" "www.sectigo.com"
    "www.fastly.com" "nim-lang.org" "www.python.org"
    "cdn.jsdelivr.net" "cdnjs.cloudflare.com" "www.mozilla.org" "curl.se"
    "www.debian.org" "www.freebsd.org" "httpbin.org"
    "www.ebay.com" "www.office.com" "www.qq.com" "login.microsoftonline.com" "www.baidu.com"
    "www.yahoo.com" "www.paypal.com" "www.bbc.co.uk" "www.amazon.com" "www.reddit.com"
]

loop hosts 'h [
    url: ~"https://|h|/"
    attempt "hosts" ~"|h| noverify" [request url ø]
    attempt "hosts" ~"|h| verify" [download.as: tmp url]
]

;------------------------------------------
; data integrity (big responses, redirects, binary)
;------------------------------------------

ts: "https://cdn.jsdelivr.net/npm/typescript@5.4.5/lib/typescript.js"
attempt "data" "9MB read (noverify) md5" [
    c: read ts
    ensure [9141067 = size c]
    ensure ["d7eb5d075ffbac5177bf496b8df08317" = digest c]
]
attempt "data" "9MB download (verify) md5" [
    download.as: tmp ts
    ensure ["d7eb5d075ffbac5177bf496b8df08317" = digest read tmp]
]
attempt "data" "670KB read (cdnjs) md5" [
    ensure ["4d8e72afd9639e074547992bce6a3de3" = digest read "https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.module.min.js"]
]
attempt "data" "binary 5.5MB via github redirect (verify) md5" [
    download.as: tmp "https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.8/mbedtls-3.6.8.tar.bz2"
    ensure ["3d4b72a42fedadb15f5c45ed8b45e307" = digest read tmp]
]
attempt "data" "http -> https redirect" [
    ensure [contains? read "http://github.com" "github"]
]
attempt "data" "https -> https cross-host redirect (noverify)" [
    ensure [contains? read "https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.8/mbedtls-3.6.8-sha256sum.txt" "bc54b818e87f49c0b3281dd85d24adaede0e63b4e822e3fbd49c005a38b9595b"]
]

;------------------------------------------
; uploads (bodies spanning many TLS records)
;------------------------------------------

big: repeat "a" 1000000
attempt "upload" "1MB POST" [
    r: request.post "https://httpbin.org/anything" big
    ensure [200 = r\status]
    ensure [contains? r\body "\"Content-Length\": \"1000000\""]
]
attempt "upload" "1MB POST (async)" [
    r: wait request.post.async "https://httpbin.org/anything" big
    ensure [200 = r\status]
    ensure [contains? r\body "\"Content-Length\": \"1000000\""]
]
attempt "upload" "json POST" [
    r: request.post.json "https://httpbin.org/anything" #[lang: "arturo" tls: "mbedtls"]
    ensure [200 = r\status]
    ensure [contains? r\body "mbedtls"]
]
attempt "upload" "PUT with headers" [
    r: request.put.headers: #[Xarturo: "tls-test"] "https://httpbin.org/anything" "hello"
    ensure [200 = r\status]
    ensure [contains? r\body "tls-test"]
]

;------------------------------------------
; many requests: sequential & concurrent
;------------------------------------------

attempt "many" "30 sequential reads" [
    sizes: map 1..30 'i -> size read "https://arturo-lang.io"
    ensure [1 = size unique sizes]
]
attempt "many" "30 sequential requests (different hosts)" [
    loop 1..10 'i [
        ensure [200 = get request "https://www.google.com" ø 'status]
        ensure [200 = get request "https://api.github.com" ø 'status]
        ensure [200 = get request "https://arturo-lang.io" ø 'status]
    ]
]
attempt "many" "16 concurrent read.async" [
    urls: flatten repeat @["https://arturo-lang.io" "https://github.com" "https://www.google.com" "https://en.wikipedia.org"] 4
    tasks: map urls 'u -> read.async u
    ensure [every? map tasks 't -> wait t 'c -> 1000 < size c]
]
attempt "many" "8 concurrent download.async (verify)" [
    tasks: map 1..8 'i -> download.async.as: ~"|tmp|.|i|" "https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.module.min.js"
    loop tasks 't -> wait t
    loop 1..8 'i -> ensure ["4d8e72afd9639e074547992bce6a3de3" = digest read ~"|tmp|.|i|"]
]

;------------------------------------------
; failures (must error out, not hang)
;------------------------------------------

attempt "fail" "plain HTTP server on 443-less port" [request.timeout: 15000 "https://example.com:80/" ø]
attempt "fail" "closed port" [request.timeout: 15000 "https://127.0.0.1:1/" ø]
attempt "fail" "unknown host" [request.timeout: 15000 "https://nonexistent.invalid/" ø]
attempt "fail" "timeout (blackhole)" [request.timeout: 3000 "https://10.255.255.1/" ø]
attempt "fail" "download verify, IP without IP SAN" [download.as: tmp "https://140.82.112.3/"]

print "done"
