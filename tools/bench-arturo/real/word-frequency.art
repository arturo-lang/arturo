; word frequency over a generated text: strings, dictionaries, sorting
vocab: split.words "the quick brown fox jumps over the lazy dog while seven wise kings quietly hum ancient tunes of distant northern lands and rivers"
nv: size vocab
seed: 7
words: []
loop 1..60000 'i [
    seed: ((seed * 1103515245) + 12345) % 2147483648
    idx: (seed / 65536) % nv
    'words ++ vocab\[idx]
]
text: join.with: " " words
counts: #[]
loop split.words text 'w [
    w: upper w
    counts\[w]: (key? counts w) ? -> counts\[w] + 1 -> 1
]
print [size counts first.n: 5 sort.descending values counts]
