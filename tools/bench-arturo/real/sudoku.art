; sudoku solver: backtracking over a block of 81 cells
puzzles: [
    "530070000600195000098000060800060003400803001700020006060000280000419005000080079"
    "000000907000420180000705026100904000050000040000507009920108000034059000507000000"
]
possible?: function [g pos d][
    r: pos / 9
    c: pos % 9
    loop 0..8 'i [
        if d = g\[(r * 9) + i] -> return false
        if d = g\[(i * 9) + c] -> return false
    ]
    br: 3 * r / 3
    bc: 3 * c / 3
    loop 0..2 'i -> loop 0..2 'j [
        if d = g\[((br + i) * 9) + bc + j] -> return false
    ]
    true
]
solve: function [g][
    pos: index g 0
    if null? pos -> return g
    loop 1..9 'd [
        if possible? g pos d [
            set g pos d
            r: solve g
            unless null? r -> return r
            set g pos 0
        ]
    ]
    null
]
loop puzzles 'p [
    g: map split p 's -> to :integer s
    print join map solve g 'x -> to :string x
]
