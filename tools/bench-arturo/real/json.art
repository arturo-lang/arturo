; JSON: building nested data, writing it out and reading it back
data: []
loop 1..3000 'i [
    'data ++ #[
        id: i
        name: ~"item |i|"
        tags: @[~"t|i % 7|" ~"t|i % 11|"]
        price: i * 3
        active: even? i
    ]
]
loop 1..5 'k [
    s: write.json data ø
    back: read.json s
]
lb: last back
print [size s size back lb\name]
