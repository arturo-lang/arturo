; binary trees: lots of short-lived allocations
make: function [d][
    switch d = 0 -> [[] []]
                 -> @[make d-1 make d-1]
]
check: function [t][
    switch empty? t\0 -> 1
                      -> 1 + (check t\0) + check t\1
]
maxDepth: 14
long: make maxDepth
total: 0
loop [4 6 8 10 12 14] 'd [
    iters: to :integer 2 ^ maxDepth - d + 4
    c: 0
    loop 1..iters 'i -> c: c + check make d
    total: total + c
]
print [total check long]
