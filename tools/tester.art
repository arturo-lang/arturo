#!/usr/bin/env arturo
;==========================================
; Tester
;
; @file: tools/tester.art
; @author: drkameleon
;==========================================

; With --web, every test is run using our
; Web/JS build instead (via tools/web-runner.js):
;
; ARTURO_JS_ENGINE: node (default) or deno
; ARTURO_JS: the build to use (default: bin/arturo.js)
; ARTURO_JS_TIMEOUT: time limit per test, in seconds (default: 120)

web?: in? "--web" arg
args: remove arg "--web"

errorMargin: 0
if 1 = size args -> errorMargin: to :integer first args

release: sys\release
runCommand: ~{|sys\binary| --no-color}

if web? [
    jsEngine: "node"
    if key? env "ARTURO_JS_ENGINE" -> jsEngine: env\ARTURO_JS_ENGINE
    unless in? jsEngine ["node" "deno"] ->
        panic.code:1 ~"Unknown JS engine: |jsEngine|"

    jsTimeout: "120"
    if key? env "ARTURO_JS_TIMEOUT" -> jsTimeout: env\ARTURO_JS_TIMEOUT

    webRunner: relative "web-runner.js"
    runCommand: switch jsEngine = "deno"
        -> ~{ARTURO_JS_TIMEOUT=|jsTimeout| deno run --allow-read --allow-env --allow-run "|webRunner|"}
        -> ~{ARTURO_JS_TIMEOUT=|jsTimeout| node "|webRunner|"}

    ; the release of the Web build, as given by `sys\release` there
    ; (for now, `sys` crashes in Web builds, so we default to what
    ; they'd normally give: 'full, since they are not MINI builds)
    release: 'full
    releaseCheck: strip execute ~{|runCommand| -e "print sys\\release"}
    if in? releaseCheck ["mini" "full"] -> release: to :literal releaseCheck
]

supersuccess: 0
superskipped: 0
supertotal: 0

; the tests to exclude (one per line, in tester.exclude.*.lst):
; - web: whatever cannot work in Web builds at all (it needs
;   the file system, other processes, concurrency or a script context)
; - mini/full: depending on the release
excluded: function [kind][
    select read.lines relative ~"tester.exclude.|kind|.lst" 'line -> not? empty? line
]

exclusions: []
if web? -> exclusions: exclusions ++ excluded "web"
if release='mini -> exclusions: exclusions ++ excluded "mini"
if release='full -> exclusions: exclusions ++ excluded "full"

canExecute?: function [scr][
    ; TODO(unittests/lib.collections) Test failing for FreeBSD builds
    ;  probable reason is `store` trying to save to a path that hasn't been 
    ;  configured yet inside our VM
    ;  labels: freebsd, unit-test

    not? in? scr exclusions
]

runSet: function [title,location].export:[supersuccess,supertotal,superskipped][
    print "====================================================================="
    print (color #cyan.bold ~"  |title|") ++ pad "passed?" 65 - size title
    print "====================================================================="

    unless exists? absolute location ->
        panic.code:1 ~"Location doesn't exist: |location|"

    tests: sort select list relative location 'loc -> contains? loc ".res"
    success: 0

    ;indiTimes: []

    loop tests 'test [
        script: replace test ".res" ".art"
        expected: read test
        ; error reports are wrapped according to the terminal's width
        ; and may include paths, so we only check for the words in them
        normalize: function [output][
            if title <> "Errors" -> return split.lines strip output
            split.words replace replace output {═} "" "\\" "/"
        ]
        expected: normalize expected
        friendlyName: decode.url extract.filename script
        prints pad.right ((color #magenta "\n- Running: ") ++ truncate.preserve friendlyName 40) 70
        switch canExecute? friendlyName [
            ;tim: benchmark.get [
                result: execute ~{|runCommand| "|script|"}
                cleanResult: split.lines strip result
                result: normalize result

            ;]
            ; indiTimes: indiTimes ++ #[
            ;     tst: test
            ;     tim: tim
            ; ]

            switch result=expected [

                prints color #green.bold "[   YES   ]"
                success: success + 1
                supersuccess: supersuccess + 1
            ][
                print "<-------------------"
                print join.with:"\n" cleanResult
                print "------------------->"
                prints color #red "[  ERROR  ]"
            ]
        ][
            prints color #orange.bold "[ SKIPPED ]"
            superskipped: superskipped + 1
            success: success + 1
            supersuccess: supersuccess + 1
        ]
    ]

    print "\n"
    print pad.left render.template "<||= success ||> of <||= size tests ||> tasks succeeded ◀" 69
    print ""

    ;inspect sort.by:'tim indiTimes

    ; supersuccess: supersuccess + success
    supertotal: supertotal + size tests
]

title: "Unit Tester"
releaseInfo: ~"@|release|"
if web? [
    title: "Web Unit Tester"
    releaseInfo: ~"@|release| (web, |jsEngine|)"
]

print color #green.bold "\n  Arturo"
print color #white.bold ~"  |title|\n"
print color #gray ~"  Release: |releaseInfo|\n"

supertime: in's benchmark.get [
    runSet "Unit Tests" "../tests/unittests"
    runSet "Errors" "../tests/errors"
    runSet "Examples" "../../examples/src/rosetta"
]

if supersuccess < supertotal-errorMargin [
    panic.code: 1 "Some unit-tests failed!"
]

print ""
print color #cyan "====================================================================="

print [color #cyan "|" color #white.bold "ANALYSIS                                                         " color #cyan "|"]
print color #cyan "====================================================================="
print [color #cyan "|" "Tests executed:" supertotal "( skipped:" superskipped ")" color #cyan pad "|" 36 - (size to :string supertotal)+size to :string superskipped]
print [color #cyan "|" "Tests succeeded:" supersuccess color #cyan pad "|" 49 - size to :string supertotal]
rate: to :string .format:".1f" 100 * supersuccess//supertotal
print color #cyan "====================================================================="
switch supersuccess=supertotal -> print [color #cyan "|" "Success rate:" color #green append rate "%" color #cyan pad "|" 51 - size rate]
                               -> print [color #cyan "|" "Success rate:" append rate "%" color #cyan pad "|" 51 - size rate]
printableTime: ~"|round.to: 2 to :floating scalar supertime| s"
print [color #cyan "|" "Total time:" printableTime color #cyan pad "|" 54 - size to :string printableTime]
print color #cyan "====================================================================="

exit
