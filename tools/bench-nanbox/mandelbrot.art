count: 0
loop 0..179 'y [
    loop 0..359 'x [
        cr: (to :floating x) / 120.0 - 2.0
        ci: (to :floating y) / 90.0 - 1.0
        zr: 0.0  zi: 0.0  i: 0
        while [i < 100][
            if 4.0 < (zr * zr) + (zi * zi) -> break
            t: ((zr * zr) - (zi * zi)) + cr
            zi: (2.0 * zr * zi) + ci
            zr: t
            i: i + 1
        ]
        if i = 100 -> count: count + 1
    ]
]
print count
