; sieve of eratosthenes up to 1,000,000
n: 1000000
m: n + 1
isPrime: array.of: m true
isPrime\0: false
isPrime\1: false
p: 2
while [(p * p) =< n][
    if isPrime\[p] [
        j: p * p
        while [j =< n][
            isPrime\[j]: false
            j: j + p
        ]
    ]
    p: p + 1
]
cnt: 0
loop isPrime 'x -> if x -> cnt: cnt + 1
print ["primes up to" n ":" cnt]
