; tiny brainfuck interpreter running nested loops
; (instructions as ASCII codes: + 43, - 45, < 60, > 62, . 46, [ 91, ] 93)
interpret: function [src][
    code: map src 'c -> to :integer c
    jumps: array.of: size code 0
    stack: []
    loop.with:'i code 'op [
        if op = 91 -> 'stack ++ i
        if op = 93 [
            o: last stack
            stack: chop stack
            jumps\[o]: i
            jumps\[i]: o
        ]
    ]
    tape: array.of: 64 0
    ptr: 0
    pc: 0
    steps: 0
    out: []
    n: size code
    while [pc < n][
        op: code\[pc]
        if op = 43 -> tape\[ptr]: (tape\[ptr] + 1) % 256
        if op = 45 -> tape\[ptr]: (tape\[ptr] + 255) % 256
        if op = 62 -> ptr: ptr + 1
        if op = 60 -> ptr: ptr - 1
        if op = 46 -> 'out ++ tape\[ptr]
        if op = 91 -> if zero? tape\[ptr] -> pc: jumps\[pc]
        if op = 93 -> if not? zero? tape\[ptr] -> pc: jumps\[pc]
        pc: pc + 1
        steps: steps + 1
    ]
    @[out steps]
]
src: (repeat "+" 12) ++ "[>" ++ (repeat "+" 12) ++ "[>" ++ (repeat "+" 12) ++ "[>" ++ (repeat "+" 40) ++ "[>+<-]<-]<-]<-]>>>>."
res: interpret src
print ["output:" res\0 "steps:" res\1]
