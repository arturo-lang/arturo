; spectral norm, n = 100: floating point, nested loops, function calls
A: function [i j][
    ij: i + j
    1.0 / to :floating (((ij * (ij + 1)) / 2) + i + 1)
]

mulAv: function [v][
    n: size v
    result: array.of: n 0.0
    loop 0..dec n 'i [
        s: 0.0
        loop 0..dec n 'j -> s: s + (A i j) * v\[j]
        result\[i]: s
    ]
    result
]

mulAtv: function [v][
    n: size v
    result: array.of: n 0.0
    loop 0..dec n 'i [
        s: 0.0
        loop 0..dec n 'j -> s: s + (A j i) * v\[j]
        result\[i]: s
    ]
    result
]

N: 100
u: array.of: N 1.0
v: []
do.times: 5 [
    v: mulAtv mulAv u
    u: mulAtv mulAv v
]

vBv: 0.0
vv: 0.0
loop 0..dec N 'i [
    vBv: vBv + u\[i] * v\[i]
    vv: vv + v\[i] * v\[i]
]
print round.to: 9 sqrt vBv / vv
