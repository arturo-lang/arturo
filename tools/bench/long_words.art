; word frequencies over generated text: strings, dictionaries, sorting
vocab: split.words "the quick brown fox jumps over lazy dog lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua"
V: size vocab
rnd: function [s][((s * 1103515245) + 12345) % 2147483648]
seed: 42
words: []
do.times: 300000 [
    seed: rnd seed
    w: vocab\[seed % V]
    seed: rnd seed
    if zero? seed % 5 -> w: upper w
    'words ++ w
]
text: join.with:" " words
freq: #[]
loop split.words text 'w [
    k: lower w
    freq\[k]: (key? freq k)? -> freq\[k] + 1 -> 1
]
print ["top counts:" first.n: 5 sort.descending values freq]
print ["distinct:" size freq "chars:" size text]
