; n-body simulation (5 planets), floating-point heavy
PI: 3.141592653589793
SOLAR: (4.0 * PI) * PI
DPY: 365.24

x:  @[0.0  4.84143144246472  8.34336671824458  12.8943695621391  15.3796971148509]
y:  @[0.0  neg 1.16032004402742  4.12479856412430  neg 15.1111514016986  neg 25.9193146099879]
z:  @[0.0  neg 0.103622044471123  neg 0.403523417114321  neg 0.223307578892655  0.179258772950371]
vx: @[0.0  0.00166007664274403 * DPY  neg 0.00276742510726862 * DPY  0.00296460137564761 * DPY  0.00268067772490389 * DPY]
vy: @[0.0  0.00769901118419740 * DPY  0.00499852801234917 * DPY  0.00237847173959480 * DPY  0.00162824170038242 * DPY]
vz: @[0.0  neg 0.0000690460016972063 * DPY  0.0000230417297573763 * DPY  neg 0.0000296589568540237 * DPY  neg 0.0000951592254519715 * DPY]
ms: @[SOLAR  0.000954791938424326 * SOLAR  0.000285885980666130 * SOLAR  0.0000436624404335156 * SOLAR  0.0000515138902046611 * SOLAR]

N: 5

energy: function [][
    e: 0.0
    loop 0..dec N 'i [
        e: e + (0.5 * ms\[i]) * ((vx\[i] * vx\[i]) + (vy\[i] * vy\[i]) + (vz\[i] * vz\[i]))
        j: i + 1
        while [j < N][
            dx: x\[i] - x\[j]
            dy: y\[i] - y\[j]
            dz: z\[i] - z\[j]
            e: e - (ms\[i] * ms\[j]) / sqrt (dx * dx) + (dy * dy) + (dz * dz)
            j: j + 1
        ]
    ]
    e
]

advance: function [dt][
    loop 0..dec N 'i [
        j: i + 1
        while [j < N][
            dx: x\[i] - x\[j]
            dy: y\[i] - y\[j]
            dz: z\[i] - z\[j]
            d2: (dx * dx) + (dy * dy) + (dz * dz)
            mag: dt / d2 * sqrt d2
            mi: ms\[i] * mag
            mj: ms\[j] * mag
            vx\[i]: vx\[i] - dx * mj
            vy\[i]: vy\[i] - dy * mj
            vz\[i]: vz\[i] - dz * mj
            vx\[j]: vx\[j] + dx * mi
            vy\[j]: vy\[j] + dy * mi
            vz\[j]: vz\[j] + dz * mi
            j: j + 1
        ]
    ]
    loop 0..dec N 'i [
        x\[i]: x\[i] + dt * vx\[i]
        y\[i]: y\[i] + dt * vy\[i]
        z\[i]: z\[i] + dt * vz\[i]
    ]
]

print round.to: 9 energy
do.times: 15000 -> advance 0.01
print round.to: 9 energy
