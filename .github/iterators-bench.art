; Temporary: the iterators benchmark
; Prints one "name<TAB>ms" line per test (best of 3), and one "## title" line per section

N: 1000000
if 0 < size arg -> N: to :integer first arg

H: N / 2
T: N / 10

blk: @1..N
pairs: map 1..T 'x -> @[x x+1]
str: repeat "a" N
words: map 1..T 'x -> ~"word|x % 1000|"
dict: #[]
loop 1..T 'x [dict\[to :string x]: x]

b10: @1..10
b100: @1..100
b1000: @1..1000

bench: function [name code][
    best: 999999.0
    do.times:3 [
        t: to :floating scalar benchmark.get code
        if t < best -> best: t
    ]
    print ~"|name|\t|round.to:2 best|"
]

section: function [title][
    print ~"## |title|"
]

;---------------------------------------------------------------
section "control (no iterators at all)"
;---------------------------------------------------------------

bench "while i<N" [i: 0 while [i < N][i: i+1]]
bench "while i<N [s: s+i]" [i: 0 s: 0 while [i < N][s: s+i i: i+1]]

;---------------------------------------------------------------
section "loop, empty body (pure iteration cost)"
;---------------------------------------------------------------

bench "loop range 'x" [loop 1..N 'x []]
bench "loop range (step 2) 'x" [loop range.step:2 1 N 'x []]
bench "loop range (backwards) 'x" [loop N..1 'x []]
bench "loop range [x y]" [loop 1..N [x y] []]
bench "loop range [x y z]" [loop 1..N [x y z] []]
bench "loop.with range 'x" [loop.with:'i 1..N 'x []]
bench "loop block 'x" [loop blk 'x []]
bench "loop block [x y]" [loop blk [x y] []]
bench "loop block [x y z]" [loop blk [x y z] []]
bench "loop.with block 'x" [loop.with:'i blk 'x []]
bench "loop integer 'x" [loop N 'x []]
bench "loop string 'x" [loop str 'x []]
bench "loop dictionary [k v]" [loop dict [k v] []]
bench "loop block of blocks 'x" [loop pairs 'x []]

;---------------------------------------------------------------
section "loop, small body"
;---------------------------------------------------------------

bench "loop range [s: s+x]" [s: 0 loop 1..N 'x [s: s+x]]
bench "loop block [s: s+x]" [s: 0 loop blk 'x [s: s+x]]
bench "loop block [x y][s: s+x*y]" [s: 0 loop blk [x y] [s: s+x*y]]
bench "loop.with block [s: s+i]" [s: 0 loop.with:'i blk 'x [s: s+i]]
bench "loop range [if ...]" [c: 0 loop 1..N 'x [if 0 = x % 15 [c: c+1]]]
bench "loop block [if ...]" [c: 0 loop blk 'x [if 0 = x % 15 [c: c+1]]]
bench "loop string [if ...]" [c: 0 loop str 'ch [if ch = 'b' [c: c+1]]]
bench "loop dictionary [s: s+v]" [s: 0 loop dict [k v] [s: s+v]]
bench "loop block of blocks [first]" [s: 0 loop pairs 'p [s: s + first p]]

;---------------------------------------------------------------
section "map"
;---------------------------------------------------------------

bench "map range 'x -> x" [m: map 1..N 'x -> x]
bench "map block 'x -> x" [m: map blk 'x -> x]
bench "map range 'x -> x*2" [m: map 1..N 'x -> x*2]
bench "map block 'x -> x*2" [m: map blk 'x -> x*2]
bench "map block [x y] -> x+y" [m: map blk [x y] -> x+y]
bench "map.with block -> x+i" [m: map.with:'i blk 'x -> x+i]
bench "map string -> upper" [m: map str 'ch -> upper ch]
bench "map words -> size" [m: map words 'w -> size w]
bench "map dictionary [k v] -> v" [m: map dict [k v] -> v]
bench "map integer 'x -> x" [m: map N 'x -> x]

;---------------------------------------------------------------
section "select / filter"
;---------------------------------------------------------------

bench "select range -> odd?" [m: select 1..N 'x -> odd? x]
bench "select block -> odd?" [m: select blk 'x -> odd? x]
bench "select block [x y]" [m: select blk [x y] -> odd? x]
bench "select.with block" [m: select.with:'i blk 'x -> odd? i]
bench "select block (none kept)" [m: select blk 'x -> x < 0]
bench "select block (all kept)" [m: select blk 'x -> x > 0]
bench "select words -> size" [m: select words 'w -> 6 < size w]
bench "filter range -> odd?" [m: filter 1..N 'x -> odd? x]
bench "filter block -> odd?" [m: filter blk 'x -> odd? x]
bench "filter block [x y]" [m: filter blk [x y] -> odd? x]

;---------------------------------------------------------------
section "fold"
;---------------------------------------------------------------

bench "fold range [a b] -> a+b" [m: fold 1..N [a b] -> a + b]
bench "fold block [a b] -> a+b" [m: fold blk [a b] -> a + b]
bench "fold.seed block" [m: fold.seed:1 blk [a b] -> a + b]
bench "fold.right block" [m: fold.right blk [a b] -> a + b]
bench "fold block [a b c]" [m: fold blk [a b c] -> a + b + c]

;---------------------------------------------------------------
section "every? / some? (full scan)"
;---------------------------------------------------------------

bench "every? range (all true)" [m: every? 1..N 'x -> x > 0]
bench "every? block (all true)" [m: every? blk 'x -> x > 0]
bench "some? range (no hit)" [m: some? 1..N 'x -> x < 0]
bench "some? block (no hit)" [m: some? blk 'x -> x < 0]

;---------------------------------------------------------------
section "other iterators"
;---------------------------------------------------------------

bench "enumerate range" [m: enumerate 1..N 'x -> odd? x]
bench "enumerate block" [m: enumerate blk 'x -> odd? x]
bench "chunk block" [m: chunk blk 'x -> 0 = (x / 100) % 2]
bench "cluster block" [m: cluster blk 'x -> x % 10]
bench "gather block" [m: gather blk 'x -> x % 10]
bench "gather words -> size" [m: gather words 'w -> size w]
bench "collect block" [m: collect blk 'x -> x > 0]
bench "collect.after block" [m: collect.after blk 'x -> x > H]
bench "maximum block" [m: maximum blk 'x -> x % 1000]
bench "minimum block" [m: minimum blk 'x -> x % 1000]
bench "arrange block (N/10)" [m: arrange slice blk 0 T-1 'x -> x % 1000]

;---------------------------------------------------------------
section "early exit, on N items (x30 calls)"
;---------------------------------------------------------------

bench "some? block, hit at 1" [k: 0 while [k < 30][m: some? blk 'x -> x > 0 k: k+1]]
bench "every? block, fails at 1" [k: 0 while [k < 30][m: every? blk 'x -> x < 0 k: k+1]]
bench "select.first block" [k: 0 while [k < 30][m: select.first blk 'x -> x > 0 k: k+1]]
bench "select.first:10 block" [k: 0 while [k < 30][m: select.first:10 blk 'x -> x > 0 k: k+1]]
bench "collect block, stops at 1" [k: 0 while [k < 30][m: collect blk 'x -> x < 0 k: k+1]]
bench "loop block [break]" [k: 0 while [k < 30][loop blk 'x [break] k: k+1]]
bench "loop integer [break]" [k: 0 while [k < 30][loop N 'x [break] k: k+1]]
bench "loop range [break]" [k: 0 while [k < 30][loop 1..N 'x [break] k: k+1]]
bench "some? block, hit at N/2" [m: some? blk 'x -> x > H]
bench "loop block [break] at N/2" [loop blk 'x [if x > H -> break]]

;---------------------------------------------------------------
section "many calls, few items (N items in total)"
;---------------------------------------------------------------

bench "loop range, 1 item" [k: 0 while [k < N][loop 1..1 'y [] k: k+1]]
bench "loop range, 10 items" [k: 0 while [k < T][loop 1..10 'y [] k: k+1]]
bench "loop range, 100 items" [k: 0 while [k < N/100][loop 1..100 'y [] k: k+1]]
bench "loop range, 1000 items" [k: 0 while [k < N/1000][loop 1..1000 'y [] k: k+1]]
bench "loop block, 10 items" [k: 0 while [k < T][loop b10 'y [] k: k+1]]
bench "loop block, 100 items" [k: 0 while [k < N/100][loop b100 'y [] k: k+1]]
bench "loop block, 1000 items" [k: 0 while [k < N/1000][loop b1000 'y [] k: k+1]]
bench "loop integer, 10 items" [k: 0 while [k < T][loop 10 'y [] k: k+1]]
bench "map block, 10 items" [k: 0 while [k < T][m: map b10 'y -> y*2 k: k+1]]
bench "map block, 100 items" [k: 0 while [k < N/100][m: map b100 'y -> y*2 k: k+1]]
bench "select block, 10 items" [k: 0 while [k < T][m: select b10 'y -> odd? y k: k+1]]
bench "select block, 100 items" [k: 0 while [k < N/100][m: select b100 'y -> odd? y k: k+1]]
bench "fold block, 10 items" [k: 0 while [k < T][m: fold b10 [a b] -> a+b k: k+1]]
bench "fold block, 100 items" [k: 0 while [k < N/100][m: fold b100 [a b] -> a+b k: k+1]]
bench "some? block, 10 items" [k: 0 while [k < T][m: some? b10 'y -> y > 9 k: k+1]]

;---------------------------------------------------------------
section "nested & combined (closer to real code)"
;---------------------------------------------------------------

bench "loop x loop, 1000x1000" [s: 0 loop 1..1000 'i [loop 1..1000 'j [s: s + i*j]]]
bench "loop x loop (blocks), 1000x1000" [s: 0 loop b1000 'i [loop b1000 'j [s: s + i*j]]]
bench "loop x loop, N/10 x 10" [s: 0 loop 1..T 'i [loop b10 'j [s: s + j]]]
bench "sum map select" [m: sum map select 1..N 'x [even? x] 'x [x*x]]
bench "fold map block" [m: fold map blk 'x [x % 7] [a b][a + b]]
bench "primes (select + some?)" [m: select 3..T/5 'n [not? some? 2..(1 + to :integer sqrt n) 'd [and? d < n  0 = n % d]]]
bench "matrix rows (map + map)" [m: map 1..1000 'i [map b100 'j [i * j]]]
bench "matrix sum (loop + fold)" [s: 0 loop 1..N/100 'i [s: s + fold b100 [a b][a + b]]]
bench "word sizes (map + gather)" [m: gather map words 'w [size w] 'x [x]]
bench "dictionary (select + map)" [m: map select dict [k v][even? v] [k v][v * 2]]
bench "pairs (loop + loop)" [s: 0 loop pairs 'p [loop p 'x [s: s + x]]]
