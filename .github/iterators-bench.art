N: 1000000
blk: @1..N
str: repeat "a" N
bench: function [name code][
    best: 999999.0
    do.times:3 [
        t: to :floating scalar benchmark.get code
        if t < best -> best: t
    ]
    print ~"|name|\t|round.to:1 best|"
]
bench "while i<N" [i: 0 while [i < N][i: i+1]]
bench "loop range 'x []" [loop 1..N 'x []]
bench "loop.with range 'x []" [loop.with:'i 1..N 'x []]
bench "loop range [x y] []" [loop 1..N [x y] []]
bench "loop block 'x []" [loop blk 'x []]
bench "loop block [x y] []" [loop blk [x y] []]
bench "loop.with block 'x []" [loop.with:'i blk 'x []]
bench "loop integer 'x []" [loop N 'x []]
bench "loop string 'x []" [loop str 'x []]
bench "loop range 'x [s: s+x]" [s: 0 loop 1..N 'x [s: s+x]]
bench "map range 'x" [m: map 1..N 'x -> x]
bench "map block 'x" [m: map blk 'x -> x]
bench "select range 'x" [m: select 1..N 'x -> odd? x]
bench "select block 'x" [m: select blk 'x -> odd? x]
bench "select block [x y]" [m: select blk [x y] -> odd? x]
bench "filter block 'x" [m: filter blk 'x -> odd? x]
bench "fold range [a b]" [m: fold 1..N [a b] -> a + b]
bench "fold block [a b]" [m: fold blk [a b] -> a + b]
bench "enumerate range 'x" [m: enumerate 1..N 'x -> odd? x]
bench "every? block 'x" [m: every? blk 'x -> x > 0]
bench "some? blk hit@1 x30" [loop 1..30 'z [m: some? blk 'x -> x > 0]]
bench "select.first blk x30" [loop 1..30 'z [m: select.first blk 'x -> x > 0]]
bench "loop blk [break] x30" [loop 1..30 'z [loop blk 'x [break]]]
bench "loop N [break] x30" [loop 1..30 'z [loop N 'x [break]]]
bench "nested 3Mx1" [loop 1..N 'x [loop 1..1 'y []]]
bench "nested 300Kx10" [loop 1..300000 'x [loop 1..10 'y []]]
bench "nested blk 300Kx10" [b: @1..10 loop 1..300000 'x [loop b 'y []]]
