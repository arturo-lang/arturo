;========================================================
; Arturo
; Programming Language + Bytecode VM compiler
; (c) 2019-2026 Yanis Zafirópulos
;
; @file: system/console.art
;========================================================

; initialize environment

__completions: map sort keys symbols => [& ++ " "]
__hints: #[]

__attrCompletions: function [k][
    ; `func.option` completions, for all options of the given function
    ; (options with no type are just flags, e.g. `loud` in `greet.loud`)
    att: get info.get k 'attrs
    map keys att 'at [
        t: att\[at]\types
        (or? [empty? t] [:logical = first t])?  -> join @[k "." at " "]
                                                -> join @[k "." at ": "]
    ]
]

loop symbols [k,v][
    if function? var k ->
        '__completions ++ __attrCompletions k
]

loop symbols [k,v][
    if function? var k [
        __hints\[k]: join.with:" " keys get info.get k 'args
    ]
]

__historyPath: join.path @[path\home ".arturo" "history.lst"]

; a fancier prompt, if the terminal can show it
; (in `Repl\promptColor`)
__promptSymbol: (terminal\unicode?)? -> "❯ " -> "$> "

; set all packager-related operations as verbose
__VerbosePackager

; helpers & templates

LongHeader: {
    |color #green.bold "Arturo"|  
    |sys\copyright| |sys\author|
}

vv: to :string sys\version
parts: split.by:"+" vv
versionPart: first parts
revisionPart: (and? 
    [contains? versionPart "-dev"]
    [1 < size parts]
)? -> last parts -> ""

Details: {# version  : |versionPart|}

unless empty? sys\codename ->
    Details: Details ++ " " ++ {|sys\codename|}

Details: Details ++ "\n"

unless empty? revisionPart ->
    Details: Details ++ {# snapshot : |revisionPart| @ |sys\built|} ++ "\n"

Details: Details ++ {# arch     : |sys\cpu\arch|/|sys\os|}

BR: "\n"

__orange: $[x][
    color #orange x
]

__orangeBold: $[x][
    color #orange.bold x
]

__printFList: function [sorted, ftype][
    llength: 80

    print repeat "-" llength
    print pad.center ((positive? size sorted)? -> to :string size sorted -> "No") ++ 
          " built-in function" ++ 
          ((1 = size sorted)? -> " " -> "s ") ++
          ftype llength
    print repeat "-" llength

    loop sorted 'key [
        v: symbols\[key]
        fparams: "(" ++ (join.with:"," to [:string] keys get info.get key 'args) ++ ")"
        finfo: get info.get key 'description
        finfo: replace finfo {/\[[^\]]+\] /} ""

        print (color.bold #magenta pad.right key 17) ++
              (pad.right fparams 30) ++
              " -> " ++
              finfo

    ]
]

__printResult: function [result, time][
    ; the result (if any) & how long it took, at the far right
    ms: scalar time
    took: ""
    if Repl\timing? ->
        took: (ms < 1000)? -> ~"|round.to:2 ms| ms" -> ~"|round.to:2 ms / 1000| s"

    width: dec terminal\width
    unless empty? result [
        line: result
        if and? [not? empty? took][and? [not? contains? result "\n"][width >= 2 + (size result) + size took]] [
            line: result ++ pad took width - size result
            took: ""
        ]
        print color #gray line
    ]
    print (empty? took)? -> "" -> color #gray pad took width
]

; terminal-only methods

help: function [][
    ;; description: « print a list of all available built-in functions
    ;; returns: :nothing

    results: select sort keys symbols 'sym ->
        function?.builtin var sym

    __printFList results "available"
]

lookup: function [what :string :literal :regex :type][
    ;; description: « lookup functions by given descriptive string or signature types
    ;; options: [
    ;;      returns: « check by return type
    ;; ]
    ;; returns: :nothing

    results: new []

    (type? what)? [
        results: select sort keys symbols 'sym ->
            function?.builtin var sym

        (null? attr "returns")? [
            results: select results 'sym ->
                contains? flatten values get info.get sym 'args what
        ] [
            results: select results 'sym ->
                contains? flatten get info.get sym 'returns what
        ]
    ] [ ; not? type? what
        results: (select sort keys symbols 'sym ->
            function? var sym) -- ["__orange" "__orangeBold" "__printFList"]

        results: select results 'sym [
            finfo: get info.get sym 'description
            fparams: keys get info.get sym 'args
            fattrs: keys get info.get sym 'attrs

            inFparams: false
            loop fparams 'fparam [
                if contains? fparam what ->
                    inFparams: true
            ]

            inFattrs: false
            loop fattrs 'fattr [
                if contains? fattr what ->
                    inFattrs: true

                if contains? get get get info.get sym 'attrs fattr 'description what ->
                    inFattrs: true
            ]

            any? @[
                contains? sym what
                contains? finfo what
                inFparams
                inFattrs
            ]
        ]
    ]

    __printFList results "found"
    discard unstack size stack
]

; REPL settings
; (changing any of them, e.g. `Repl\timing?: false`,
; also saves it in the global config - so that it sticks)

__settings: store.global "config.art"
__startup: join.path @[path\home ".arturo" "repl.art"]
__loading: false

__savedSettings: function [][
    settings: to :dictionary __settings
    (key? settings "repl")? -> settings\repl -> #[]
]

__saveSetting: function [what, value][
    saved: __savedSettings
    saved\[what]: value
    set __settings "repl" saved
]

define :__replSettings [
    intro?: true
    autocomplete?: true
    hints?: true
    verbose?: true
    timing?: true
    types?: true
    cleanStack?: false
    promptColor: #orange

    set: method [what, value][
        set.field this what value
        unless __loading ->
            try [__saveSetting what value]
    ]
]

Repl: to :__replSettings []

__loading: true
loop __savedSettings [k,v] ->
    Repl\[k]: v
__loading: false

; terminal-only methods get auto-completions & hints too

loop ["help" "lookup"] 'k [
    '__completions ++ k ++ " "
    __hints\[k]: join.with:" " keys get info.get k 'args
]

; anything not defined by now (or by the loop below) is user-defined

__internal: #[]
loop (keys symbols) ++ ["__internal" "__userSymbols" "__got" "__command" "__inp" "__err" "__stackSize" "__time" "__result" "__userCompletions" "__prompt" "__promptColor"] 'k ->
    __internal\[k]: true

; the user's own startup file, if any
; (e.g. for handy helpers - any `Repl` settings
; in there are just for this session, not saved)

if exists? __startup [
    __loading: true
    try.verbose [do __startup]
    __loading: false
]

; print header (and the intro, unless it's turned off)

clear
print join @[
    ~LongHeader BR BR
    color #gray ~Details BR
]

if Repl\intro? [
    print join @[
        __orange "# Type "
        __orangeBold "help"
        __orange " to get a list of all available functions with a short description" BR
        __orange "# Type "
        __orangeBold {lookup "something"}
        __orange " to lookup a specific function by name/description or type" BR
        __orange "# Type "
        __orangeBold "info 'symbol"
        __orange " for info about a specific symbol or built-in function" BR BR
        __orange "# For multi-line input, leave a bracket open or end the line with two spaces" BR
        __orange "# Use TAB for auto-completion, UP for navigating history" BR
        __orange "# Type "
        __orangeBold "Repl\\intro?: false"
        __orange " to skip this intro from now on" BR BR
        __orange "# Launching interactive console - rock on! 🤘" BR
    ]
]

; start the REPL

while [true] [
    ;push null
    __got: null

    __userSymbols: select keys symbols 'k -> not? key? __internal k
    __userCompletions: map __userSymbols 'k -> k ++ " "
    loop __userSymbols 'k [
        (function? var k)? [
            __hints\[k]: join.with:" " keys get info.get k 'args
            '__userCompletions ++ __attrCompletions k
        ][if key? __hints k -> remove '__hints .key k]
    ]

    __command: [input.repl .history: __historyPath]
    if Repl\autocomplete? -> append '__command [.complete: __completions ++ __userCompletions]
    if Repl\hints? -> append '__command [.hint: __hints]
    __promptColor: Repl\promptColor
    unless color? __promptColor -> __promptColor: #orange
    __prompt: color.bold __promptColor __promptSymbol
    append '__command [__prompt]

    __inp: do __command

    __err: try.verbose [
        __stackSize: size stack
        __time: benchmark.get [__err: try.verbose to :block __inp]

        __result: ""
        if Repl\verbose? [
            ; (only what this entry left - not any older leftovers)
            if __stackSize < size stack -> __got: unstack 1
            unless null? __got [
                __result: render.once "=> |__got|"
                if Repl\types? -> __result: __result ++ " :" ++ to :string type __got
            ]
        ]

        __printResult __result __time

        ; don't let leftover values pile up
        if and? [Repl\cleanStack?] [0 < size stack] ->
            discard unstack size stack
    ]
]
