; main routes
ROUTES: #[
    GET: #[]
    POST: #[]
    PUT: #[]
    PATCH: #[]
    DELETE: #[]
]

; per-method fallbacks (`GET any -> ...`)
FALLBACKS: #[]

; route helpers
addRoute: function [method, pattern, action][
    if :any = type pattern [
        FALLBACKS\[method]: var'action
        return null
    ]
    ROUTES\[method]\[express pattern]: var'action
]

GET:    function [pattern, action]-> addRoute "GET" pattern var'action
POST:   function [pattern, action]-> addRoute "POST" pattern var'action
PUT:    function [pattern, action]-> addRoute "PUT" pattern var'action
PATCH:  function [pattern, action]-> addRoute "PATCH" pattern var'action
DELETE: function [pattern, action]-> addRoute "DELETE" pattern var'action

; the name of each capturing group in given regex,
; in order (or `null`, for unnamed ones) - so that
; we can tell positional captures from named ones
captureGroups: function [rx][
    src: to :string rx
    groups: new []
    inClass: false
    i: 0
    while -> i < size src [
        c: to :string get src i
        when [
            c = "\\" [ i: i + 1 ]           ; skip escaped char
            inClass  [ if c = "]" -> inClass: false ]
            c = "["  [ inClass: true ]
            c = "(" [
                rest: drop.times: i + 1 src
                switch not? prefix? rest "?" ->
                    'groups ++ @[null]
                [
                    ; (?<name>...), (?P<name>...) or (?'name'...);
                    ; anything else - (?:...), lookarounds, inline
                    ; flags - is not a capturing group
                    named: match.capture rest {/^\?(?:P?<([A-Za-z_][A-Za-z0-9_]*)>|'([A-Za-z_][A-Za-z0-9_]*)')/}
                    unless empty? named [
                        name: first select first named => [not? null? &]
                        'groups ++ name
                    ]
                ]
            ]
        ]
        i: i + 1
    ]
    return groups
]

; initial route initialization
initServerInternal: function [serverRoutes][
    do serverRoutes
]

; main request handler
serveInternal: function [Request][
    serverResponse: #[
        body: ""
        status: null
        headers: #[]
        benchmark: 0.0
    ]

    emit: function [str][
        servedContent: "text/plain"

        if not? null? attr 'css     -> servedContent: "text/css"
        if not? null? attr 'html    -> servedContent: "text/html"
        if not? null? attr 'js      -> servedContent: "application/javascript"
        if not? null? attr 'json    -> servedContent: "application/json"
        if not? null? attr 'xml     -> servedContent: "application/xml"

        if asContent: <= attr 'as   -> servedContent: asContent

        servedHeaders: #[
            "Content-Type": servedContent
        ]
        extraHeaders: attr 'headers
        if not? null? extraHeaders ->
            extend 'servedHeaders extraHeaders

        extraStatus: attr 'status
        if not? null? extraStatus ->
            serverResponse\status: extraStatus

        serverResponse\headers: servedHeaders
        return str
    ]

    callActionFunction: function [actionFunc, ptrn][
        actionParams: keys get info.get 'actionFunc 'args
        passedParams: new []
        if positive? size actionParams [
            groupNames: new []
            matchedGroups: #[]
            unnamedValues: new []
            if regex? ptrn [
                anchored: to :regex "^" ++ (to :string ptrn) ++ "$"
                groupNames: captureGroups ptrn

                matches: match.named.capture Request\path anchored
                unless empty? matches ->
                    matchedGroups: first matches

                ; values of unnamed groups, in order
                if contains? groupNames null [
                    positional: first match.capture Request\path anchored
                    unless block? positional ->
                        positional: @[positional]
                    loop.with:'idx groupNames 'groupName [
                        if null? groupName ->
                            'unnamedValues ++ @[positional\[idx]]
                    ]
                ]
            ]
            loop actionParams 'actionParam [
                ; exactly one value per parameter (`null`, if missing);
                ; precedence: route captures > query > body
                paramValue: null

                if and? [dictionary? Request\body][key? Request\body actionParam] ->
                    paramValue: Request\body\[actionParam]

                if key? Request\query actionParam ->
                    paramValue: Request\query\[actionParam]

                switch contains? groupNames actionParam [
                    ; named groups go by name...
                    if key? matchedGroups actionParam ->
                        paramValue: matchedGroups\[actionParam]
                ][
                    ; ...unnamed ones fill the remaining
                    ; parameters, left to right
                    unless empty? unnamedValues [
                        paramValue: first unnamedValues
                        unnamedValues: drop unnamedValues
                    ]
                ]

                'passedParams ++ @[paramValue]
            ]
        ]

        call var'actionFunc passedParams
    ]

    runAction: function [action, ptrn][
        routeError: try.verbose [
            (block? var'action)? [
                serverResponse\body: do action
            ][
                serverResponse\body: callActionFunction var'action ptrn
            ]
            if null? serverResponse\status ->
                serverResponse\status: 200 ; OK
        ]
        unless null? routeError [
            serverResponse\body: "Internal Server Error"
            serverResponse\status: 500
        ]
    ]

    getServerResponse: [
        ; methods we have no routes table for (HEAD, OPTIONS, ...)
        ; simply fall through to the 404 below
        methodRoutes: (key? ROUTES Request\method)? -> ROUTES\[Request\method] -> #[]
        loop keys methodRoutes 'pattern [
            originalPattern: parse pattern

            matched?: (regex? originalPattern)? 
                -> not? empty? match Request\path ("^" ++ (to :string originalPattern) ++ "$")
                -> (to :string originalPattern) = Request\path

            if matched? [
                runAction methodRoutes\[pattern] originalPattern
                break
            ]
        ]

        ; nothing matched? try the method's fallback, if any
        if and? [null? serverResponse\status][key? FALLBACKS Request\method] ->
            runAction FALLBACKS\[Request\method] null
    ]

    serverResponse\benchmark: benchmark.get getServerResponse

    if null? serverResponse\status [
        serverResponse\body: "Not Found"
        serverResponse\status: 404
    ]

    return serverResponse
]